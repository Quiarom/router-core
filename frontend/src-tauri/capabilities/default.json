{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permite iniciar únicamente los servicios locales de router-core.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/router-core",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/router-core-agent",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}

# EditorConfig: https://editorconfig.org
# Applies to every editor that respects EditorConfig (VS Code, GoLand,
# vim/Neovim, Emacs, etc.). Lets every contributor use their own
# editor without producing style drift in the committed files.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{md,yml,yaml,json,toml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{go}]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.sh]
indent_style = space
indent_size = 2
